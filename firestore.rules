rules_version = '2';

// Estella security rules — data model v2 (see docs/DATA-MODEL.md).
// Publish: `firebase deploy --only firestore:rules` (docs/SERVER.md), or paste into Firebase console → Firestore Database → Rules → Publish.
// Friends: search directory, friend requests, friend lists and friend cards are below. Groups, trainers and leaderboards get
// their rules when those features ship.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // sharing = { profile, routines, workouts, body }, each 'private' | 'friends' | 'public'
    function validSharing(data) {
      return !('sharing' in data)
        || (data.sharing.keys().hasOnly(['profile', 'routines', 'workouts', 'body'])
            && data.sharing.values().hasOnly(['private', 'friends', 'public']));
    }

    // Usernames: 3–20 chars, a–z 0–9 _ . — not starting/ending with "." — no ".." — not reserved (same list as js/utils/username.js).
    function validUsername(name) {
      return name.matches('^[a-z0-9_][a-z0-9_.]{1,18}[a-z0-9_]$')
        && !name.matches('.*[.][.].*')
        && !(name in ['admin', 'administrator', 'estella', 'support', 'soporte', 'help', 'ayuda', 'root', 'system', 'moderator', 'mod',
                      'staff', 'team', 'official', 'oficial', 'null', 'undefined', 'me', 'api', 'www', 'app', 'settings', 'trainer', 'entrenador']);
    }

    // A profile may only point at a username this person owns (claimed in the same batch).
    function ownsUsername(data) {
      return !('username' in data)
        || getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == request.auth.uid;
    }
    // The username on my profile (rules may read any document, the app can't).
    function myUsername() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null);
    }
    function usernameOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('username', null);
    }
    // A friend request from a to b exists and is accepted (after this write).
    function acceptedRequest(a, b) {
      return existsAfter(/databases/$(database)/documents/friendRequests/$(a + '_' + b))
        && getAfter(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted';
    }

    function usernameUnchanged() {
      return request.resource.data.get('username', null) == resource.data.get('username', null);
    }

    // Once an account is on v2, an old copy of the app can't overwrite the profile (it would drop schemaVersion).
    function keepsSchemaVersion() {
      return !('schemaVersion' in resource.data)
        || ('schemaVersion' in request.resource.data && request.resource.data.schemaVersion >= resource.data.schemaVersion);
    }

    match /users/{uid} {
      // Profile + settings. The v1 `state` field stays here as a backup until it's cleaned up.
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validSharing(request.resource.data) && ownsUsername(request.resource.data);
      allow update: if isOwner(uid) && validSharing(request.resource.data) && keepsSchemaVersion()
                    && (usernameUnchanged() || ownsUsername(request.resource.data));
      allow delete: if isOwner(uid);   // "Delete account" in the app (data first, then this, then the sign-in)

      // The person's own data.
      match /routines/{id}        { allow read, write: if isOwner(uid); }
      match /sessions/{id}        { allow read, write: if isOwner(uid); }
      match /exerciseStats/{id}   { allow read, write: if isOwner(uid); }
      match /body/{id}            { allow read, write: if isOwner(uid); }
      match /customExercises/{id} { allow read, write: if isOwner(uid); }

      // friends/{fid} = { since, username, displayName }. Being on someone's list is what will let you see what they
      // share with friends, so nobody can add themselves: entries need an accepted request between the two.
      //  - the owner adds a friend once a request either way was accepted (in the same batch);
      //  - the person who accepts adds themselves to the sender's list (the sender asked for it);
      //  - either of the two can remove the entry (unfriending clears both lists).
      match /friends/{fid} {
        allow read: if isOwner(uid);
        allow create: if request.resource.data.keys().hasOnly(['since', 'username', 'displayName'])
          && ((isOwner(uid) && (acceptedRequest(fid, uid) || acceptedRequest(uid, fid)))
              || (signedIn() && request.auth.uid == fid && acceptedRequest(uid, fid)));
        allow update: if isOwner(uid) && request.resource.data.keys().hasOnly(['since', 'username', 'displayName']);
        allow delete: if isOwner(uid) || (signedIn() && request.auth.uid == fid);
      }

      // Written only by Estella's server functions (points and mascot growth can't be edited from a phone).
      match /mascot/{id} { allow read: if isOwner(uid); allow write: if false; }
      match /wallet/{id} { allow read: if isOwner(uid); allow write: if false; }
    }

    // directory/{uid} = { username, displayName, nameKey, lastKey, character, updatedAt }: what friend search shows. Only there
    // while "Aparecer en búsquedas" is on. Anyone signed in can search it (20 results at most); only the owner writes
    // it, and only with their own username.
    match /directory/{uid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'nameKey', 'lastKey', 'character', 'updatedAt'])
        && request.resource.data.username == myUsername()
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.nameKey is string && request.resource.data.nameKey.size() <= 60
        && request.resource.data.lastKey is string && request.resource.data.lastKey.size() <= 60;
      allow delete: if isOwner(uid);
    }

    // friendRequests/{from}_{to} = { from, to, fromUsername, fromName, toUsername, toName, status, createdAt, respondedAt }
    // Only the two people involved can see it. The sender creates it (as themselves, to someone who exists and isn't
    // already their friend); the receiver can only accept it; either can delete it (cancel / decline / unfriend).
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromUsername', 'fromName', 'toUsername', 'toName', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fromUsername == myUsername()
        && request.resource.data.toUsername == usernameOf(request.resource.data.to)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to));
      allow update: if signedIn() && resource.data.to == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // profileCards/{uid}: what friends see (week, weekly goal, streak, last workout). Written only by the server
    // (functions/index.js), never from a phone. visibility = the owner's "Tu perfil" sharing setting:
    //   private → only the owner · friends → the owner and their friends · public → anyone signed in.
    // Asking for a card that doesn't exist yet is allowed (there's nothing in it to see).
    match /profileCards/{uid} {
      allow get: if signedIn() && (resource == null
        || request.auth.uid == uid
        || resource.data.visibility == 'public'
        || (resource.data.visibility == 'friends'
            && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid))));
      allow list: if false;
      allow write: if false;
    }

    // usernames/{name} → { uid, createdAt }: one document per taken name keeps names unique.
    // Anyone signed in can look up one exact name (to add a friend); nobody can list them all.
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validUsername(name)
                    && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null) == name;
      allow update: if false;
      // Freed only by its owner, when their profile no longer uses it (changing username) or is being deleted.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
                    && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
                        || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', null) != name);
    }
  }
}
